<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <!--
    SEC-02: the database is PostgreSQL on Supabase. The real connection string carries a
    password, so it never lives in this file. Put it in the git-ignored
    App_Data\local.settings.config under the key Db:ConnectionString, which
    DatabaseHelper reads first. The entry below is only a password-less fallback for a
    local PostgreSQL instance.
  -->
  <connectionStrings>
    <add name="TutorConnectDb"
         connectionString="Host=localhost;Port=5432;Database=postgres;Username=postgres;Search Path=dbo"
         providerName="Npgsql" />
  </connectionStrings>
  <!--
    Local, machine-specific settings live in App_Data\local.settings.config, which is
    git-ignored. The file attribute makes it optional: the application still starts when
    it is absent, and the seeder then refuses to run rather than inventing a password.

    Recognised keys:
      Db:ConnectionString       - the Supabase PostgreSQL connection string (with password).
      Seed:DevPassword          - hashed at run time to create the development accounts.
      Sql:CommandTimeoutSeconds - how long a command may run. Absent or 0 means no limit,
                                  which is the shipped default. Set a positive number here
                                  if an unlimited timeout is holding request threads open.
                                  The connect timeout is separate and lives in the
                                  connection string above (Connect Timeout=0).
  -->
  <appSettings file="App_Data\local.settings.config" />
  <system.web>
    <compilation debug="true" targetFramework="4.8.1">
      <!-- Npgsql 8 targets netstandard2.0; pages compiled at run time need this facade. -->
      <assemblies>
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
        <add assembly="System.Data.Common, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
      </assemblies>
    </compilation>
    <!-- Async page handlers require the 4.5+ quirks mode that targetFramework sets. -->
    <httpRuntime targetFramework="4.8.1" />
    <globalization culture="en-ZA" uiCulture="en-ZA" />

    <!-- SEC-04. The application starts at the Login page; there is no public landing page. -->
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login.aspx"
             defaultUrl="~/Account/Login.aspx"
             name=".TUTORCONNECTAUTH"
             protection="All"
             timeout="30"
             slidingExpiration="true"
             cookieless="UseCookies"
             requireSSL="true" />
    </authentication>

    <!-- Everything requires a signed-in user unless a <location> below says otherwise. -->
    <authorization>
      <deny users="?" />
    </authorization>

    <!-- SEC-07 -->
    <httpCookies httpOnlyCookies="true" requireSSL="true" />

    <!-- SEC-06. Event validation stays on; ViewState is encrypted, not merely signed. -->
    <pages enableEventValidation="true"
           viewStateEncryptionMode="Always"
           enableViewStateMac="true" />

    <sessionState mode="InProc" cookieless="UseCookies" timeout="30" />

    <!--
      SEC-11. RemoteOnly keeps the developer's yellow screen on this machine while any
      other client sees only a friendly page and a reference id. ErrorLogger writes the
      detail to App_Data\Logs and supplies the reference the page displays, so the number
      a user quotes actually locates the fault. 404 is handled in Global.asax so it stays
      friendly even locally.
    -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/ErrorPages/Error500.aspx" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="~/ErrorPages/Error404.aspx" />
      <error statusCode="403" redirect="~/ErrorPages/Error404.aspx" />
    </customErrors>
  </system.web>

  <!-- Anonymous access, needed before a user can possibly be signed in. -->
  <location path="Account">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- Static assets must not redirect to the login page, or the sign-in screen loads unstyled. -->
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Images">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- An anonymous visitor who mistypes a URL must see the error page itself, not be
       bounced to the login screen by the deny rule above. -->
  <location path="ErrorPages">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!--
    SEC-04, URL-level role authorisation. These work because Global.asax rebuilds a
    GenericPrincipal carrying the role from the ticket on every request.
    deny users="*" after the allow is required: without it, any authenticated user passes.

    Notifications is the one area open to all three roles - a single page picks its master
    from the signed-in role - but still closed to anonymous visitors.
  -->
  <location path="Notifications">
    <system.web>
      <authorization>
        <allow roles="Student,Tutor,Administrator" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Student">
    <system.web>
      <authorization>
        <allow roles="Student" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Tutor">
    <system.web>
      <authorization>
        <allow roles="Tutor" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Administrator" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <!-- The application starts at Login. There is no public landing page (Part A). -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Account/Login.aspx" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <!--
          SEC-12. Cookies already carry requireSSL, but that only stops them being sent
          over HTTP - it does not stop the browser trying HTTP in the first place. HSTS
          makes the browser rewrite to HTTPS itself for a year.

          Sent unconditionally: IIS Express serves this application over HTTPS, and a
          deployment that is not on HTTPS is misconfigured rather than a case to support.
        -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />

        <!-- The application never frames itself and should never be framed: clickjacking. -->
        <add name="X-Frame-Options" value="DENY" />

        <!-- Stop a browser second-guessing a declared content type. -->
        <add name="X-Content-Type-Options" value="nosniff" />

        <!-- A booking URL should not leak to a third party through a referrer. -->
        <add name="Referrer-Policy" value="same-origin" />

        <!-- Nothing here uses a camera, a microphone or a location. -->
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />

        <!-- Announcing the server version helps nobody but an attacker. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <!-- Npgsql 8 is built for netstandard2.0; these unify its dependency versions on .NET Framework. -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly><assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="Microsoft.Extensions.DependencyInjection.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="Microsoft.Extensions.Logging.Abstractions" publicKeyToken="adb9793829ddae60" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Collections.Immutable" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Text.Encodings.Web" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-8.0.0.5" newVersion="8.0.0.5" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Threading.Channels" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1" /></dependentAssembly>
      <dependentAssembly><assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" /><bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" /></dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
</configuration>
