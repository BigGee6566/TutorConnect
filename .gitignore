# Local, machine-specific settings. Holds the development seed password (D-07).
# The .sample template beside it IS committed; this file never is.
App_Data/local.settings.config

# Runtime fault log written by ErrorLogger. Diagnostic output, not source.
App_Data/Logs/

# Build output
bin/
obj/
*.dll
*.pdb
*.xml

# Visual Studio
.vs/
*.user
*.suo

# NuGet packages restored on build
packages/

# Test run output
TestResults/

# Generated administrator credentials - never commit
ADMIN-LOGIN.local.txt

# Vendored Npgsql assemblies are committed (the global *.dll rule above excludes them otherwise)
!lib/**/*.dll

# Publish output from deploy/Deploy-MonsterAsp.ps1
deploy/out/
