<?xml version="1.0" encoding="utf-8"?>
<!--
  Test configuration. Points at the same local SQL Server Express instance the application
  uses. The tests rebuild the schema from 01_CreateSchema.sql on every run, so they must
  never be pointed at anything but a disposable database.
-->
<configuration>
  <connectionStrings>
    <add name="TutorConnectDb"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=TutorConnect;Integrated Security=True;Application Name=TutorConnect.Tests;Connect Timeout=0"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Not a production credential: the seeder hashes this at run time to create the
         development accounts the tests sign in with. -->
    <add key="Seed:DevPassword" value="TutorDev2026!" />
  </appSettings>
</configuration>
