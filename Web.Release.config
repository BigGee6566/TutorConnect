<?xml version="1.0" encoding="utf-8"?>

<!--
  Release transform. Applied when the project is published, not when it is built, so
  running locally still uses the values in Web.config.

  For more information on web.config transformation:
  https://go.microsoft.com/fwlink/?LinkId=125889
-->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <system.web>

    <!--
      The single most important line in this file.

      debug="true" disables request timeouts, suppresses batch compilation, keeps full
      symbol information in memory, and makes ASP.NET far more willing to show a detailed
      error page. Shipping it is a performance problem and an information-disclosure one.
      Web.config keeps debug="true" for local work; this turns it off for anything published.
    -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!--
      Off, not RemoteOnly, in a published build: RemoteOnly still shows the full yellow
      screen to anyone browsing from the server itself, which on a deployed machine is not
      the developer. ErrorLogger records the detail; the user gets a reference.
    -->
    <customErrors mode="On"
                  defaultRedirect="~/ErrorPages/Error500.aspx"
                  redirectMode="ResponseRewrite"
                  xdt:Transform="SetAttributes(mode)" />

  </system.web>

  <!--
    SEC-02. The connection string is replaced at publish time and then encrypted on the
    server with:

        aspnet_regiis.exe -pe "connectionStrings" -app "/TutorConnect"

    The placeholder below is deliberately not a working credential. Integrated Security is
    preferred so no password exists to protect in the first place; if SQL authentication is
    unavoidable, encrypt the section immediately after deployment and never commit the
    populated value.
  -->
  <connectionStrings>
    <add name="TutorConnectDb"
         connectionString="Data Source=SET-ME;Initial Catalog=TutorConnect;Integrated Security=True;Connect Timeout=0"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>

</configuration>
